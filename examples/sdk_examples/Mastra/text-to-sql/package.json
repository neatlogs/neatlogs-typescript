{
  "name": "text-to-sql",
  "version": "1.0.0",
  "description": "A Mastra template for natural language to SQL conversion using a local SQLite database.",
  "main": "index.js",
  "scripts": {
    "seed": "tsx src/seed.ts",
    "dev": "tsx src/seed.ts && mastra dev",
    "build": "mastra build",
    "start": "mastra start"
  },
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.23.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@libsql/client": "^0.17.0",
    "@mastra/core": "latest",
    "@mastra/libsql": "latest",
    "@mastra/loggers": "latest",
    "@mastra/memory": "latest",
    "@mastra/observability": "latest",
    "@neatlogs/instrumentation-mastra": "^0.1.3",
    "@opentelemetry/api": "^1.9.1",
    "neatlogs": "^1.0.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.19.7",
    "mastra": "latest",
    "tsx": "^4.19.4",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "neatlogs": "^1.0.3",
      "@neatlogs/instrumentation-mastra": "^0.1.3"
    }
  }
}