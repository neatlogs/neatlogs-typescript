{
  "name": "neatlogs",
  "version": "1.0.0",
  "description": "AI agent debugging, collaboration, and trace observability. Built for teams using CrewAI, OpenAI, and more.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["dist"],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "dev": "tsup --watch"
  },
  "keywords": ["observability", "tracing", "opentelemetry", "llm", "ai", "agents", "debugging"],
  "license": "MIT",
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.57.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.57.0",
    "@opentelemetry/resources": "^1.30.0",
    "@opentelemetry/sdk-logs": "^0.57.0",
    "@opentelemetry/sdk-metrics": "^1.30.0",
    "@opentelemetry/sdk-trace-base": "^1.30.0",
    "@opentelemetry/sdk-trace-node": "^1.30.0",
    "@opentelemetry/semantic-conventions": "^1.28.0",
    "@opentelemetry/instrumentation-http": "^0.57.0",
    "@opentelemetry/instrumentation-undici": "^0.10.0",
    "@opentelemetry/instrumentation": "^0.57.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "peerDependencies": {
    "@arizeai/openinference-instrumentation-openai": ">=1.0.0",
    "@arizeai/openinference-instrumentation-anthropic": ">=1.0.0",
    "@arizeai/openinference-instrumentation-langchain": ">=1.0.0",
    "@arizeai/openinference-instrumentation-bedrock": ">=1.0.0",
    "@arizeai/openinference-instrumentation-mcp": ">=1.0.0",
    "@arizeai/openinference-instrumentation-beeai": ">=1.0.0",
    "@arizeai/openinference-instrumentation-claude-agent-sdk": ">=1.0.0",
    "@google/genai": ">=0.1.0",
    "@mastra/core": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@arizeai/openinference-instrumentation-openai": { "optional": true },
    "@arizeai/openinference-instrumentation-anthropic": { "optional": true },
    "@arizeai/openinference-instrumentation-langchain": { "optional": true },
    "@arizeai/openinference-instrumentation-bedrock": { "optional": true },
    "@arizeai/openinference-instrumentation-mcp": { "optional": true },
    "@arizeai/openinference-instrumentation-beeai": { "optional": true },
    "@arizeai/openinference-instrumentation-claude-agent-sdk": { "optional": true },
    "@google/genai": { "optional": true },
    "@mastra/core": { "optional": true }
  }
}
