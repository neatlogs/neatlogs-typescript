# =============================================================================
# neatlogs TypeScript SDK — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
#
# Shell environment variables ALWAYS override .env values loaded by dotenv.
# For a fully deterministic run, use:
#   env -i HOME="$HOME" PATH="$PATH" VAR1=val1 VAR2=val2 npx tsx examples/...
#
# Do NOT commit secrets to source control.
# =============================================================================

# ---------------------------------------------------------------------------
# Neatlogs SDK
# ---------------------------------------------------------------------------
NEATLOGS_API_KEY=
NEATLOGS_ENDPOINT=http://localhost:4100
# Optional prefix prepended to example workflow names and root workflow spans.
# Useful for making TypeScript example runs easy to find in the hosted UI.
NEATLOGS_WORKFLOW_PREFIX=

# ---------------------------------------------------------------------------
# Azure OpenAI
# ---------------------------------------------------------------------------
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_LLM_DEPLOYMENT=
AZURE_REASONING_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# ---------------------------------------------------------------------------
# Google GenAI / Gemini
# ---------------------------------------------------------------------------
GOOGLE_API_KEY=
# GEMINI_API_KEY=           # alias — GOOGLE_API_KEY is preferred

# ---------------------------------------------------------------------------
# AWS (Bedrock — Anthropic examples)
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-west-1

# ---------------------------------------------------------------------------
# Database (verification scripts only — not used by examples)
# ---------------------------------------------------------------------------
# CLICKHOUSE_HOST=
# CLICKHOUSE_PORT=
# CLICKHOUSE_USER=
# CLICKHOUSE_PASSWORD=
# CLICKHOUSE_DATABASE=
# POSTGRES_HOST=
# POSTGRES_PORT=
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_DATABASE=

# ---------------------------------------------------------------------------
# Marketing Strategy Demo
# ---------------------------------------------------------------------------
# MARKETING_MOCK_MODE=true   # Set to true for a fast run without API calls
